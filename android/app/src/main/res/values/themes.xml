<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Compose (Material 3) draws the entire UI. This platform theme only styles the window
        until the first frame; values-night/themes.xml provides the dark variant so dark-mode
        users don't see a white flash on launch. The window background is the Compose theme's
        surface (cream, or green charcoal at night).
    -->
    <style name="Base.Theme.GrocerySync" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <style name="Theme.GrocerySync" parent="Base.Theme.GrocerySync" />
</resources>
