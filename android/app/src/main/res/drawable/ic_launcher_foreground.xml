<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground: a shopping basket with a check mark, drawn in a single color so the
    same drawable also works as the monochrome (themed) icon. Everything stays inside the 66dp
    safe zone centred in the 108dp canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Handle -->
    <path
        android:fillColor="#00000000"
        android:pathData="M41,46 C41,35 46.5,29 54,29 C61.5,29 67,35 67,46"
        android:strokeWidth="4"
        android:strokeColor="@color/ic_launcher_foreground"
        android:strokeLineCap="round" />

    <!-- Rim -->
    <path
        android:fillColor="@color/ic_launcher_foreground"
        android:pathData="M33.5,44 H74.5 A2.5,2.5 0 0 1 77,46.5 V48.5 A2.5,2.5 0 0 1 74.5,51 H33.5 A2.5,2.5 0 0 1 31,48.5 V46.5 A2.5,2.5 0 0 1 33.5,44 Z" />

    <!-- Basket body -->
    <path
        android:fillColor="#00000000"
        android:pathData="M35,55 H73 L69,77 Q68.6,79 66.6,79 H41.4 Q39.4,79 39,77 Z"
        android:strokeWidth="4"
        android:strokeColor="@color/ic_launcher_foreground"
        android:strokeLineJoin="round" />

    <!-- Check mark -->
    <path
        android:fillColor="#00000000"
        android:pathData="M45.5,66.5 L51,72 L62.5,60.5"
        android:strokeWidth="4"
        android:strokeColor="@color/ic_launcher_foreground"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
