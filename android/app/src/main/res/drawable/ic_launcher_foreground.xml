<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground (also the Android 12+ splash icon): a cream cloth bag (jhola) with a
    turmeric check mark. Everything stays inside the 66dp safe zone centred in the 108dp canvas.
    The same artwork, with its background, is docs/images/app-icon.svg.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Strap -->
    <path
        android:fillColor="#00000000"
        android:pathData="M39.5,47 C39.5,27 51,27 51,47 M57,47 C57,27 68.5,27 68.5,47"
        android:strokeWidth="4"
        android:strokeColor="@color/ic_launcher_cream"
        android:strokeLineCap="round" />

    <!-- Bag -->
    <path
        android:fillColor="@color/ic_launcher_cream"
        android:pathData="M36,46 H72 Q73.6,46 73.8,47.6 L76.4,74 Q76.8,79 71.8,79 H36.2 Q31.2,79 31.6,74 L34.2,47.6 Q34.4,46 36,46 Z" />

    <!-- Folded hem along the top of the bag -->
    <path
        android:fillColor="@color/ic_launcher_hem"
        android:pathData="M34.3,46.6 Q34.6,46 36,46 H72 Q73.4,46 73.7,46.6 L74.1,51 H33.9 Z" />

    <!-- Check mark: turmeric, edged in the brand green so it stands out on the cream bag -->
